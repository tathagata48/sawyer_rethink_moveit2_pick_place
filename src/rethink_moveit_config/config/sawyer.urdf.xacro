<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="sawyer">
    <xacro:arg name="electric_gripper" default="true"/>
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import sawyer urdf file -->
    <xacro:include filename="$(find sawyer_description)/urdf/sawyer.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="sawyer.ros2_control.xacro" />


    <xacro:sawyer_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
